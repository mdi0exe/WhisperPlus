<Window x:Class="WhisperPlus.Views.Widgets.DictationWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WhisperPlus.Views.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="WhisperPlus Dictation"
        Width="440"
        Height="124"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">

    <!--  The margin is the shadow's room to breathe: the window is transparent, so the card
          has to sit inside it with space to spare or the blur is clipped at the edges.
          Every measurement here is the large size; the compact one is applied in code-behind
          (see the Metrics record) so the two layouts cannot drift apart.  -->
    <Border x:Name="CardBorder"
            Margin="18,10,18,20"
            Padding="16,12"
            Background="{StaticResource Wp.Widget.Fill}"
            BorderBrush="{StaticResource Wp.Widget.Stroke}"
            BorderThickness="1"
            CornerRadius="24"
            MouseLeftButtonDown="CardBorder_MouseLeftButtonDown">
        <Border.RenderTransform>
            <TranslateTransform />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="34"
                              Direction="270"
                              Opacity="0.6"
                              ShadowDepth="8"
                              Color="#000000" />
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Mic orb. The ring carries the state color; the glyph stays legible on the dark
                  well rather than being tinted along with it.  -->
            <Grid x:Name="Orb"
                  Grid.Column="0"
                  Width="46"
                  Height="46"
                  Margin="0,0,14,0"
                  VerticalAlignment="Center">
                <!--  Pulse: only while listening, so "the mic is open" is visible peripherally.  -->
                <Ellipse RenderTransformOrigin="0.5,0.5"
                         Stroke="{Binding StatusBrush}"
                         StrokeThickness="1.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform />
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Listening">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="PulseStory">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.75"
                                                                 To="0"
                                                                 Duration="0:0:1.6" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 From="0.85"
                                                                 To="1.5"
                                                                 Duration="0:0:1.6" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="0.85"
                                                                 To="1.5"
                                                                 Duration="0:0:1.6" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="PulseStory" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <Ellipse Fill="{StaticResource Wp.Widget.Chip}"
                         Stroke="{Binding StatusBrush}"
                         StrokeThickness="1.5" />

                <ui:SymbolIcon x:Name="StatusIcon"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="21"
                               Foreground="{Binding StatusBrush}"
                               Symbol="Mic24" />
            </Grid>

            <!--  Detected-language chip. Click to correct the guess; the menu is built at
                  runtime from the user's active languages.  -->
            <Border x:Name="LanguageChip"
                    Grid.Column="1"
                    Margin="0,0,14,0"
                    Padding="10,5"
                    MinWidth="38"
                    VerticalAlignment="Center"
                    Background="{StaticResource Wp.Widget.Chip}"
                    BorderBrush="{Binding LanguageChipBorder}"
                    BorderThickness="1.5"
                    CornerRadius="999"
                    Cursor="Hand"
                    MouseLeftButtonUp="LanguageChip_Click"
                    ToolTip="Dictation language — click to change"
                    Visibility="{Binding LanguageChipVisibility}">
                <TextBlock x:Name="LanguageChipText"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource Wp.Font.Mono}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{Binding LanguageChipBrush}"
                           Text="{Binding DetectedLanguage}" />
            </Border>

            <!--  Live waveform + status/preview text  -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <controls:WaveformControl x:Name="Waveform"
                                          Height="26"
                                          BarBrush="{StaticResource Wp.WaveGradient}"
                                          ShowIdleAnimation="False" />
                <TextBlock x:Name="StatusLabel"
                           Margin="0,5,0,0"
                           FontFamily="{StaticResource Wp.Font.Text}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Wp.Widget.Text}"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding StatusVisibility}" />
                <!--  Words as they are recognized, while the user is still speaking.  -->
                <TextBlock x:Name="PreviewLabel"
                           Margin="0,2,0,0"
                           FontFamily="{StaticResource Wp.Font.Text}"
                           FontSize="11"
                           Foreground="{StaticResource Wp.Widget.TextFaint}"
                           Text="{Binding PreviewText}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding PreviewVisibility}" />
            </StackPanel>

            <!--  Dismiss. Cancels the session outright: no paste, no clipboard, no history.  -->
            <Button x:Name="CloseButton"
                    Grid.Column="3"
                    Margin="10,-4,-6,0"
                    Click="CloseButton_Click"
                    Style="{StaticResource Wp.WidgetCloseButton}"
                    ToolTip="Close — cancels dictation and keeps nothing" />
        </Grid>
    </Border>
</Window>
