<Window x:Class="WhisperPlus.ScreenCapture.PinnedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="WhisperPlus Pin"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="OnDragStart"
        MouseDoubleClick="OnMouseDoubleClick"
        MouseWheel="OnZoomWheel"
        PreviewKeyDown="OnKeyDown">

    <Window.Resources>
        <ContextMenu x:Key="PinMenu">
            <MenuItem Header="Copy image" InputGestureText="Ctrl+C" Click="OnCopy" />
            <MenuItem Header="Copy text (OCR)" Click="OnOcr" />
            <MenuItem Header="Actual size (100%)" InputGestureText="Double-click" Click="OnActualSize" />
            <MenuItem Header="Reset opacity (100%)" Click="OnResetOpacity" />
            <Separator />
            <MenuItem Header="Close pin" InputGestureText="Esc" Click="OnClose" />
        </ContextMenu>

        <Style x:Key="PinHudButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinCloseHudButton" BasedOn="{StaticResource PinHudButton}" TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFF6B7E" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Margin=18 provides sufficient bounds for the soft drop shadow without clipping -->
    <Grid Margin="18"
          ContextMenu="{StaticResource PinMenu}"
          MouseRightButtonUp="OnFrameRightClick">

        <!-- Shadow host: separate from content so clip geometry does not prune the shadow -->
        <Border x:Name="ShadowHost"
                Background="#01000000"
                CornerRadius="10"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect x:Name="PinShadow"
                                  BlurRadius="28"
                                  Direction="270"
                                  Opacity="0.52"
                                  ShadowDepth="7"
                                  Color="#000000" />
            </Border.Effect>
        </Border>

        <!-- Main screenshot content with true corner clipping -->
        <Grid x:Name="ImageClipHost" SizeChanged="OnImageClipHostSizeChanged">
            <Image x:Name="Shot"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>

        <!-- Glass border over the image edge -->
        <Border x:Name="FrameBorder"
                BorderBrush="#38FFFFFF"
                BorderThickness="1.2"
                CornerRadius="10"
                IsHitTestVisible="False" />

        <!-- Mini HUD bar in top-right, visible on hover -->
        <Border x:Name="HudBar"
                Margin="8"
                Padding="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#D9161820"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="9"
                Opacity="0"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PinHudButton}"
                        Click="OnCopy"
                        ToolTip="Copy to clipboard (Ctrl+C)">
                    <ui:SymbolIcon Symbol="Copy24" FontSize="13" />
                </Button>
                <Button Style="{StaticResource PinHudButton}"
                        Click="OnOcr"
                        ToolTip="Copy text (OCR)">
                    <ui:SymbolIcon Symbol="TextCaseTitle24" FontSize="13" />
                </Button>
                <Button Style="{StaticResource PinHudButton}"
                        Click="OnActualSize"
                        ToolTip="Actual size 1:1 (Double-click)">
                    <ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="13" />
                </Button>
                <Button Style="{StaticResource PinCloseHudButton}"
                        Click="OnClose"
                        ToolTip="Close (Esc)">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Temporary badge for zoom / opacity / copy feedback -->
        <Border x:Name="StatusBadge"
                Margin="8"
                Padding="8,3"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="#D9161820"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="7"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock x:Name="StatusBadgeText"
                       FontFamily="{DynamicResource Wp.Font.Mono}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#F2FFFFFF" />
        </Border>
    </Grid>
</Window>
