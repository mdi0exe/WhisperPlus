<!--
    Aurora control templates. These replace WPF-UI's defaults for the handful of controls the
    app actually uses, so buttons, pickers, switches, menus and scrollbars all share one
    language: 10–12 px rounding, a hairline stroke, a translucent fill over the Mica backdrop,
    and a single interaction overlay that lightens on dark themes and darkens on light ones.

    Cross-file resource references use DynamicResource on purpose. Everything `Wp.*` is
    republished by ThemeService whenever the theme or the user's color changes, so a static
    reference would freeze the first look for the life of the process.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  ================================================================
          Buttons
          ================================================================  -->

    <!--
        The interaction overlay is what keeps this one template usable for every appearance:
        instead of a hover color per variant, a neutral veil (white on dark, ink on light)
        fades in over whatever fill the variant chose.
    -->
    <ControlTemplate x:Key="Wp.Template.Button" TargetType="{x:Type ui:Button}">
        <Border x:Name="Root"
                Background="{DynamicResource Wp.Surface}"
                BorderBrush="{DynamicResource Wp.Stroke}"
                BorderThickness="1"
                CornerRadius="10"
                RenderTransformOrigin="0.5,0.5"
                SnapsToDevicePixels="True">
            <Grid>
                <Border x:Name="Overlay"
                        Background="{DynamicResource Wp.TextPrimary}"
                        CornerRadius="10"
                        Opacity="0" />
                <StackPanel Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <ContentPresenter x:Name="IconHost"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Icon}"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                    <ContentPresenter x:Name="Label"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                      TextElement.FontWeight="{TemplateBinding FontWeight}"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </StackPanel>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <!--  No glyph assigned: drop the icon slot entirely so padding stays symmetric.  -->
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconHost" Property="Margin" Value="0" />
            </Trigger>

            <!--  Variants. Appearance only picks the resting fill; hover/press come from the overlay.  -->
            <Trigger Property="Appearance" Value="Primary">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.AccentGradient}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.AccentEdge}" />
                <Setter Property="Foreground" Value="{DynamicResource Wp.AccentOn}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Info">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.AccentFaint}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.AccentEdge}" />
                <Setter Property="Foreground" Value="{DynamicResource Wp.AccentText}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Success">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.SuccessSoft}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.SuccessEdge}" />
                <Setter Property="Foreground" Value="{DynamicResource Wp.Success}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Caution">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.WarningSoft}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.WarningEdge}" />
                <Setter Property="Foreground" Value="{DynamicResource Wp.Warning}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Danger">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.DangerSoft}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.DangerEdge}" />
                <Setter Property="Foreground" Value="{DynamicResource Wp.Danger}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Transparent">
                <Setter TargetName="Root" Property="Background" Value="Transparent" />
                <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Overlay" Property="Opacity" Value="0.08" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.StrokeStrong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Overlay" Property="Opacity" Value="0.16" />
                <!--  Set the whole transform: a Freezable named inside a template can't be a
                      Setter target, so the press "squish" is applied as a value, not a tweak.  -->
                <Setter TargetName="Root" Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.975" ScaleY="0.975" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Keyed *and* applied implicitly. Deriving a page-local variant must use the key:
        `BasedOn="{StaticResource {x:Type ui:Button}}"` resolves to WPF-UI's own style rather
        than this one, which silently restores WPF-UI's template (and with it an accent-filled
        default) for anything built on it.
    -->
    <Style x:Key="Wp.Button" TargetType="{x:Type ui:Button}">
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{DynamicResource Wp.Font.Text}" />
        <Setter Property="Foreground" Value="{DynamicResource Wp.TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!--  Pin the resting variant: WPF-UI's own default is Primary, so without this every
              button that doesn't ask for an appearance arrives accent-filled.  -->
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="Template" Value="{StaticResource Wp.Template.Button}" />
    </Style>

    <Style BasedOn="{StaticResource Wp.Button}" TargetType="{x:Type ui:Button}" />

    <!--  Plain WPF buttons never inherit the ui:Button style (implicit styles key off the exact
          type), so they get the same look through a slimmer, icon-less template.  -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{DynamicResource Wp.Font.Text}" />
        <Setter Property="Foreground" Value="{DynamicResource Wp.TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{DynamicResource Wp.Surface}"
                            BorderBrush="{DynamicResource Wp.Stroke}"
                            BorderThickness="1"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Overlay"
                                    Background="{DynamicResource Wp.TextPrimary}"
                                    CornerRadius="10"
                                    Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================================================================
          ComboBox — intentionally not restyled
          ================================================================

          There is no implicit ComboBox style here, and adding one is a trap worth explaining.

          Defining `<Style TargetType="ComboBox">` in this dictionary shadows WPF-UI's implicit
          style. A style without a Template setter does not then inherit WPF-UI's template — WPF
          falls back to the built-in *theme* style, so the picker reverts to the old Aero look.
          Supplying a template instead means re-implementing the open/close negotiation between
          the control, its ToggleButton and its Popup, which is what broke the dropdowns: the
          field toggled open and shut within a single click, so no list ever appeared.

          WPF-UI's ComboBox already matches the rest of the app, because it reads the
          ControlCornerRadius and accent tokens that Tokens.xaml and ThemeService override.
          Per-instance sizing (MinWidth) is set on the pages.  -->

    <!--  ================================================================
          Toggle switch
          ================================================================  -->

    <Style TargetType="{x:Type ui:ToggleSwitch}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:ToggleSwitch}">
                    <Grid Width="46"
                          Height="26"
                          Background="Transparent">
                        <Border x:Name="Track"
                                Background="{DynamicResource Wp.SurfaceSunken}"
                                BorderBrush="{DynamicResource Wp.StrokeStrong}"
                                BorderThickness="1"
                                CornerRadius="999" />
                        <Border x:Name="OnTrack"
                                Background="{DynamicResource Wp.AccentGradient}"
                                BorderBrush="{DynamicResource Wp.AccentEdge}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Opacity="0" />
                        <Ellipse x:Name="Thumb"
                                 Width="16"
                                 Height="16"
                                 Margin="5,0,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource Wp.TextSecondary}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Wp.TextTertiary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Wp.AccentOn}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="20"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OnTrack"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OnTrack"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================================================================
          Progress bar
          ================================================================  -->

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource Wp.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid>
                        <Border x:Name="PART_Track"
                                Background="{DynamicResource Wp.SurfaceSunken}"
                                BorderBrush="{DynamicResource Wp.Stroke}"
                                BorderThickness="1"
                                CornerRadius="999" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Wp.AccentGradient}"
                                CornerRadius="999">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Opacity="0.5"
                                                  ShadowDepth="0"
                                                  Color="#6759FF" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================================================================
          Scrollbars — thin, unobtrusive, thickening under the pointer
          ================================================================  -->

    <Style x:Key="Wp.ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Root" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Wp.ScrollBarPageButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Wp.ScrollBarPageButton}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="Transparent">
                                                <Border x:Name="Bar"
                                                        Width="4"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource Wp.StrokeStrong}"
                                                        CornerRadius="999" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Width" Value="7" />
                                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Wp.TextTertiary}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bar" Property="Width" Value="7" />
                                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Wp.AccentText}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Wp.ScrollBarPageButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Wp.ScrollBarPageButton}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border Background="Transparent">
                                                        <Border x:Name="Bar"
                                                                Height="4"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource Wp.StrokeStrong}"
                                                                CornerRadius="999" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bar" Property="Height" Value="7" />
                                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Wp.TextTertiary}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ================================================================
          Tooltips, menus
          ================================================================  -->

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="{DynamicResource Wp.TextPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{DynamicResource Wp.Font.Text}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Margin="6"
                            Padding="10,6"
                            Background="{DynamicResource Wp.SurfaceFlyout}"
                            BorderBrush="{DynamicResource Wp.Stroke}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              Opacity="0.35"
                                              ShadowDepth="4"
                                              Color="#000000" />
                        </Border.Effect>
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Foreground" Value="{DynamicResource Wp.TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource Wp.Font.Text}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Margin="8"
                            Padding="5"
                            Background="{DynamicResource Wp.SurfaceFlyout}"
                            BorderBrush="{DynamicResource Wp.Stroke}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28"
                                              Opacity="0.45"
                                              ShadowDepth="8"
                                              Color="#000000" />
                        </Border.Effect>
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Wp.Separator" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,5" />
        <Setter Property="Background" Value="{DynamicResource Wp.Stroke}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Wp.Separator}" TargetType="{x:Type Separator}" />

    <!--  Separators dropped into a menu resolve this keyed style, not the implicit one.  -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
           BasedOn="{StaticResource Wp.Separator}"
           TargetType="{x:Type Separator}" />

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Wp.TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource Wp.Font.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="8">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Check mark occupies a fixed gutter so labels line up either way.  -->
                            <ui:SymbolIcon x:Name="Check"
                                           Grid.Column="0"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource Wp.AccentText}"
                                           Symbol="Checkmark24"
                                           Visibility="Collapsed" />
                            <ContentPresenter x:Name="HeaderHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <TextBlock x:Name="GestureText"
                                       Grid.Column="2"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Wp.TextTertiary}"
                                       Text="{TemplateBinding InputGestureText}" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   HorizontalOffset="4"
                                   IsOpen="{Binding IsSubmenuOpen,
                                                    RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   PopupAnimation="Fade">
                                <Border Margin="8"
                                        Padding="5"
                                        Background="{DynamicResource Wp.SurfaceFlyout}"
                                        BorderBrush="{DynamicResource Wp.Stroke}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="28"
                                                          Opacity="0.45"
                                                          ShadowDepth="8"
                                                          Color="#000000" />
                                    </Border.Effect>
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================================================================
          InfoBar — kept as ui:InfoBar so pages and code-behind keep the same
          API (IsOpen / Title / Message / Severity), with an Aurora skin.
          ================================================================  -->

    <Style TargetType="{x:Type ui:InfoBar}">
        <Setter Property="Foreground" Value="{DynamicResource Wp.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Wp.Font.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:InfoBar}">
                    <Border x:Name="Root"
                            Padding="16,14"
                            Background="{DynamicResource Wp.AccentFaint}"
                            BorderBrush="{DynamicResource Wp.AccentEdge}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="IconWell"
                                    Width="28"
                                    Height="28"
                                    Margin="0,1,12,0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Wp.AccentSoft}"
                                    CornerRadius="999">
                                <ui:SymbolIcon x:Name="Glyph"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="{DynamicResource Wp.AccentText}"
                                               Symbol="Info24" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Wp.TextPrimary}"
                                           Text="{TemplateBinding Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="MessageText"
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource Wp.TextSecondary}"
                                           LineHeight="18"
                                           Text="{TemplateBinding Message}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
