<!--
    Aurora typography. One keyed style per role — no implicit TextBlock style, because a
    ContentPresenter materializes string content as a TextBlock and an implicit style would
    leak page text colors into every button, combo box and menu item in the app.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Wp.Font.Display">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="Wp.Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Wp.Font.Mono">Cascadia Mono, Consolas, Segoe UI</FontFamily>

    <!--  Shared base: every role inherits the text face and crisp rendering.  -->
    <Style x:Key="Wp.Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Wp.Font.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="Foreground" Value="{DynamicResource Wp.TextPrimary}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!--  Page title, e.g. "Voice models".  -->
    <Style x:Key="Wp.Text.Hero"
           BasedOn="{StaticResource Wp.Text.Base}"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Wp.Font.Display}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="36" />
    </Style>

    <Style x:Key="Wp.Text.Title"
           BasedOn="{StaticResource Wp.Text.Base}"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Wp.Font.Display}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Wp.Text.Subtitle"
           BasedOn="{StaticResource Wp.Text.Base}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  All-caps group label above a stack of cards. Write the text in caps at the call site;
          WPF has no letter-spacing, so size and color carry the hierarchy instead.  -->
    <Style x:Key="Wp.Text.Section"
           BasedOn="{StaticResource Wp.Text.Base}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Wp.TextTertiary}" />
    </Style>

    <Style x:Key="Wp.Text.CardTitle"
           BasedOn="{StaticResource Wp.Text.Base}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Wp.Text.Body"
           BasedOn="{StaticResource Wp.Text.Base}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Wp.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Wp.Text.Caption"
           BasedOn="{StaticResource Wp.Text.Base}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Wp.TextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <Style x:Key="Wp.Text.Micro"
           BasedOn="{StaticResource Wp.Text.Base}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Wp.TextTertiary}" />
    </Style>

    <Style x:Key="Wp.Text.Accent"
           BasedOn="{StaticResource Wp.Text.Base}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Wp.AccentText}" />
    </Style>

    <!--  Paths, sizes, gestures — anything the eye should be able to scan column-wise.  -->
    <Style x:Key="Wp.Text.Mono"
           BasedOn="{StaticResource Wp.Text.Base}"
           TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Wp.Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Wp.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
