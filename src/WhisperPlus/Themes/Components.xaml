<!--
    Aurora components: the page furniture the settings UI is assembled from. Each of these is
    a lookless control declared in Views/Controls/AuroraControls.cs; the implicit styles below
    are their only templates, resolved from Application.Resources.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:WhisperPlus.Views.Controls"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  ================================================================
          Shared surfaces
          ================================================================  -->

    <Style x:Key="Wp.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Wp.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wp.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Wp.Divider" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Wp.Stroke}" />
        <Setter Property="Margin" Value="0,18" />
    </Style>

    <!--  Dismiss button for the floating widgets. They have no title bar, so this is the only
          way out with a mouse — and it cancels the work rather than finishing it, which is why
          it hovers red instead of taking the accent color.  -->
    <Style x:Key="Wp.WidgetCloseButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource Wp.Widget.TextDim}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Well" Fill="Transparent" />
                        <ui:SymbolIcon x:Name="Glyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{TemplateBinding Foreground}"
                                       Symbol="Dismiss24" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Well" Property="Fill" Value="#33FF6B7E" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="#FF6B7E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================================================================
          PageHeader
          ================================================================  -->

    <Style TargetType="{x:Type c:PageHeader}">
        <Setter Property="Margin" Value="0,0,0,26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:PageHeader}">
                    <Border Padding="22,20"
                            Background="{DynamicResource Wp.AccentWash}"
                            BorderBrush="{DynamicResource Wp.Stroke}"
                            BorderThickness="1"
                            CornerRadius="20"
                            SnapsToDevicePixels="True"
                            TextElement.Foreground="{DynamicResource Wp.TextPrimary}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Accent tile. The glow is what separates it from a flat square.  -->
                            <Border x:Name="IconTile"
                                    Width="54"
                                    Height="54"
                                    Margin="0,0,18,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Wp.AccentGradient}"
                                    CornerRadius="17">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22"
                                                      Opacity="0.45"
                                                      ShadowDepth="4"
                                                      Color="#000000" />
                                </Border.Effect>
                                <ui:SymbolIcon HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="26"
                                               Foreground="{DynamicResource Wp.AccentOn}"
                                               Symbol="{TemplateBinding Icon}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource Wp.Text.Hero}" Text="{TemplateBinding Title}" />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{DynamicResource Wp.Text.Body}"
                                           Text="{TemplateBinding Subtitle}" />
                            </StackPanel>

                            <Border x:Name="BadgeHost"
                                    Grid.Column="2"
                                    Margin="18,0,0,0"
                                    Padding="13,8"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Wp.AccentFaint}"
                                    BorderBrush="{DynamicResource Wp.AccentEdge}"
                                    BorderThickness="1"
                                    CornerRadius="999">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,7,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource Wp.AccentText}"
                                                   Symbol="{TemplateBinding BadgeIcon}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{DynamicResource Wp.Text.Accent}"
                                               Text="{TemplateBinding Badge}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Badge" Value="">
                            <Setter TargetName="BadgeHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="Empty">
                            <Setter TargetName="IconTile" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================================================================
          SectionHeader
          ================================================================  -->

    <Style TargetType="{x:Type c:SectionHeader}">
        <Setter Property="Margin" Value="4,22,0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:SectionHeader}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="3"
                                    Height="13"
                                    Margin="0,0,9,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Wp.AccentGradientVertical}"
                                    CornerRadius="999" />
                            <TextBlock VerticalAlignment="Center"
                                       Style="{DynamicResource Wp.Text.Section}"
                                       Text="{TemplateBinding Title}" />
                        </StackPanel>
                        <TextBlock x:Name="SubtitleText"
                                   Margin="12,6,0,0"
                                   MaxWidth="640"
                                   HorizontalAlignment="Left"
                                   Style="{DynamicResource Wp.Text.Caption}"
                                   Text="{TemplateBinding Subtitle}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================================================================
          SettingCard
          ================================================================  -->

    <Style TargetType="{x:Type c:SettingCard}">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:SettingCard}">
                    <Border x:Name="Root"
                            Padding="18,15"
                            Background="{DynamicResource Wp.Surface}"
                            BorderBrush="{DynamicResource Wp.Stroke}"
                            BorderThickness="1"
                            CornerRadius="16"
                            SnapsToDevicePixels="True"
                            TextElement.Foreground="{DynamicResource Wp.TextPrimary}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="IconTile"
                                    Width="38"
                                    Height="38"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Wp.AccentFaint}"
                                    BorderBrush="{DynamicResource Wp.AccentEdge}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <ui:SymbolIcon HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="18"
                                               Foreground="{DynamicResource Wp.AccentText}"
                                               Symbol="{TemplateBinding Icon}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource Wp.Text.CardTitle}" Text="{TemplateBinding Title}" />
                                <TextBlock x:Name="DescriptionText"
                                           Margin="0,4,16,0"
                                           MaxWidth="520"
                                           HorizontalAlignment="Left"
                                           Style="{DynamicResource Wp.Text.Caption}"
                                           Text="{TemplateBinding Description}" />
                            </StackPanel>

                            <ContentPresenter x:Name="ContentHost"
                                              Grid.Row="0"
                                              Grid.Column="2"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="Empty">
                            <Setter TargetName="IconTile" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Wide content (palettes, chip walls) drops below the header instead of
                              being squeezed into a trailing column.  -->
                        <Trigger Property="IsStacked" Value="True">
                            <Setter TargetName="ContentHost" Property="Grid.Row" Value="1" />
                            <Setter TargetName="ContentHost" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ContentHost" Property="Grid.ColumnSpan" Value="3" />
                            <Setter TargetName="ContentHost" Property="Margin" Value="0,16,0,0" />
                            <Setter TargetName="ContentHost" Property="HorizontalAlignment" Value="Stretch" />
                        </Trigger>

                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.AccentFaint}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.AccentEdge}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.SurfaceHover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================================================================
          NavItem
          ================================================================  -->

    <Style TargetType="{x:Type c:NavItem}">
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!--  Explicit group name: RadioButtons only auto-group among siblings, and the rail
              splits its items across a main panel and a footer panel.  -->
        <Setter Property="GroupName" Value="WhisperPlusNav" />
        <!--  The label is the item's accessible name; without this a screen reader announces
              an unnamed radio button, since the visible text lives in the template.  -->
        <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:NavItem}">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!--  Selection rail. Scales in from the middle so switching pages reads
                                  as the indicator moving rather than blinking.  -->
                            <Border x:Name="Indicator"
                                    Width="3"
                                    Height="18"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Wp.AccentGradientVertical}"
                                    CornerRadius="999"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.3" />
                                </Border.RenderTransform>
                            </Border>

                            <StackPanel Margin="16,0,12,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="Glyph"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               FontSize="18"
                                               Foreground="{DynamicResource Wp.TextSecondary}"
                                               Symbol="{TemplateBinding Icon}" />
                                <TextBlock x:Name="LabelText"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Wp.Font.Text}"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource Wp.TextSecondary}"
                                           Text="{TemplateBinding Label}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.SurfaceHover}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Wp.TextPrimary}" />
                            <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource Wp.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.AccentFaint}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Wp.AccentText}" />
                            <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource Wp.TextPrimary}" />
                            <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1"
                                                         Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.3"
                                                         Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================================================================
          Badge
          ================================================================  -->

    <Style TargetType="{x:Type c:Badge}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Badge}">
                    <Border x:Name="Root"
                            Padding="11,5"
                            Background="{DynamicResource Wp.AccentFaint}"
                            BorderBrush="{DynamicResource Wp.AccentEdge}"
                            BorderThickness="1"
                            CornerRadius="999">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="Glyph"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{DynamicResource Wp.AccentText}"
                                           Symbol="{TemplateBinding Icon}" />
                            <ContentPresenter x:Name="Label"
                                              VerticalAlignment="Center"
                                              TextElement.FontFamily="{DynamicResource Wp.Font.Text}"
                                              TextElement.FontSize="11.5"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{DynamicResource Wp.AccentText}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="Empty">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Success">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.SuccessSoft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.SuccessEdge}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Wp.Success}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Wp.Success}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Warning">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.WarningSoft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.WarningEdge}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Wp.Warning}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Wp.Warning}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Danger">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.DangerSoft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.DangerEdge}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Wp.Danger}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Wp.Danger}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="Neutral">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.SurfaceStrong}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.Stroke}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Wp.TextSecondary}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Wp.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================================================================
          GlassPanel
          ================================================================  -->

    <Style TargetType="{x:Type c:GlassPanel}">
        <Setter Property="Padding" Value="18" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:GlassPanel}">
                    <Border x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource Wp.Surface}"
                            BorderBrush="{DynamicResource Wp.Stroke}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True"
                            TextElement.Foreground="{DynamicResource Wp.TextPrimary}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsAccent" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wp.AccentWash}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wp.AccentEdge}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
